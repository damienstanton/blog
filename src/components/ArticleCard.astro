---
interface Props {
  title: string;
  slug: string;
  readingTime: number;
  description?: string;
}

const { title, slug, readingTime, description } = Astro.props;
---

<a href={`/${slug}`} class="article-card">
  <div class="article-card-title">{title}</div>
  <div class="article-card-meta">{readingTime} min read</div>
  {description && <p class="article-card-excerpt">{description}</p>}
</a>
