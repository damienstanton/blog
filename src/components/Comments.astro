---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
// Bluesky auto-attaches a rich link card when the post text contains a URL,
// so this opens a pre-filled compose box showing the article as an embedded card.
const composeUrl = `https://bsky.app/intent/compose?text=${encodeURIComponent(title + '\n\n' + url)}`;
---

<div class="comments-section">
  <p class="comments-heading">Comments</p>
  <a class="comments-discuss-link" href={composeUrl} target="_blank" rel="noopener noreferrer">
    Discuss on Bluesky
  </a>
</div>
