---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const searchUrl = `https://bsky.app/search?q=${encodeURIComponent(url)}`;
const composeUrl = `https://bsky.app/intent/compose?text=${encodeURIComponent(title + '\n\n' + url)}`;
---

<div class="comments-section">
  <p class="comments-heading">Comments</p>
  <div class="comments-bluesky">
    <a href={searchUrl} target="_blank" rel="noopener noreferrer">
      View discussions on Bluesky
    </a>
    <span class="comments-separator">·</span>
    <a href={composeUrl} target="_blank" rel="noopener noreferrer">
      Post about this
    </a>
  </div>
</div>
