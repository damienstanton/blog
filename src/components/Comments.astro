---
interface Props {
  slug: string;
  title: string;
  url: string;
}

const { slug, title, url } = Astro.props;
const appId = import.meta.env.PUBLIC_CUSDIS_APP_ID;
if (!appId) {
  throw new Error('PUBLIC_CUSDIS_APP_ID is not set. Add it to your .env file.');
}
---

<div class="comments-section">
  <p class="comments-heading">Comments</p>
  <div
    id="cusdis_thread"
    data-host="https://cusdis.com"
    data-app-id={appId}
    data-page-id={slug}
    data-page-url={url}
    data-page-title={title}
  >
  </div>
  <script async defer src="https://cusdis.com/js/cusdis.es.js"></script>
</div>
